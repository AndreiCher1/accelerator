# Оставьте пустым при dev-сервере Vite (прокси /api → localhost:8080)
VITE_API_URL=

# DEV-ONLY: принудительно проставить роль на фронте для тестирования админских вкладок.
# Допустимые значения: creator, admin, user. Пусто — использовать роль с бекенда.
# ВНИМАНИЕ: бекенд по-прежнему проверяет реальную роль в JWT, защищённые ручки могут
# вернуть 403. Это влияет только на отображение UI. Перезапусти `pnpm dev` после изменения.
VITE_DEV_ROLE=

# Тестовые задачи в браузере (без бекенда). true — все запросы к /tasks идут
# в in-memory мок: список содержит готовые/обрабатываемые/ошибочные записи,
# upload создаёт новую задачу, статус сам продвигается по конвейеру.
# Удобно для проверки вёрстки. Перезапусти `pnpm dev` после изменения.
VITE_USE_MOCK_TASKS=false
